# =============================================================================
# RELATIONSHIP MAPS
# Source: ./data/attack/relationships.json (preprocessed from STIX bundles)
# =============================================================================

<#MitigationToTechnique> a rr:TriplesMap;
  rml:logicalSource [
    rml:source              "./data/attack/relationships.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator            "$[?(@['source type']=='mitigation' && @['target type']=='technique')]"
  ];
  rr:subjectMap [
    rr:template "http://example.com/ucoex#{source ID}"
  ];
  rr:predicateObjectMap [
    rr:predicate            <http://example.com/ucoex#mitigates>;
    rr:objectMap [ rr:parentTriplesMap <#ATTACKMap>;        rr:joinCondition [ rr:child "target_ref"; rr:parent "id" ] ]
  ];
  rr:predicateObjectMap [
    rr:predicate            <http://example.com/ucoex#mitigates>;
    rr:objectMap [ rr:parentTriplesMap <#ATTACKMap_Mobile>; rr:joinCondition [ rr:child "target_ref"; rr:parent "id" ] ]
  ];
  rr:predicateObjectMap [
    rr:predicate            <http://example.com/ucoex#mitigates>;
    rr:objectMap [ rr:parentTriplesMap <#ATTACKMap_ICS>;    rr:joinCondition [ rr:child "target_ref"; rr:parent "id" ] ]
  ].


