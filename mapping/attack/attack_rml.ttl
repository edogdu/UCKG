# =============================================================================
# ENTITY MAPS — ENTERPRISE DOMAIN
# Source: cti/enterprise-attack/enterprise-attack.json
# =============================================================================

<#ATTACKMap> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "./data/cti/enterprise-attack.json";
        rml:referenceFormulation ql:JSONPath;
        rml:iterator "$.objects[?(@.type=='attack-pattern' && @.x_mitre_deprecated!=true)]"
    ];
    rr:subjectMap [
        rr:template "http://example.com/ucoex#{external_references[0].external_id}";
        rr:class <http://purl.org/cyber/ucoAttackPattern>;
        rr:class <http://example.com/ucoexTechnique>
    ];
    rr:predicateObjectMap [ rr:predicate <http://example.com/ucoexNAME>; rr:objectMap [ rml:reference "name"; rr:datatype xsd:string ] ];
    rr:predicateObjectMap [ rr:predicate <http://example.com/ucoexDESCRIPTION>; rr:objectMap [ rml:reference "description"; rr:datatype xsd:string ] ];
    rr:predicateObjectMap [ rr:predicate <http://example.com/ucoexURL>; rr:objectMap [ rml:reference "external_references[0].url"; rr:datatype xsd:string ] ];
    rr:predicateObjectMap [ rr:predicate <http://example.com/ucoexDOMAIN>; rr:objectMap [ rml:reference "x_mitre_domains[*]"; rr:datatype xsd:string ] ];
    rr:predicateObjectMap [ rr:predicate <http://example.com/ucoexSTIX_ID>; rr:objectMap [ rml:reference "id"; rr:datatype xsd:string ] ];
    rr:predicateObjectMap [ rr:predicate <http://example.com/ucoexCREATED>; rr:objectMap [ rml:reference "created"; rr:datatype xsd:string ] ];
    rr:predicateObjectMap [ rr:predicate <http://example.com/ucoexMODIFIED>; rr:objectMap [ rml:reference "modified"; rr:datatype xsd:string ] ];
    rr:predicateObjectMap [ rr:predicate <http://example.com/ucoexSTIX_TYPE>; rr:objectMap [ rml:reference "type"; rr:datatype xsd:string ] ].


