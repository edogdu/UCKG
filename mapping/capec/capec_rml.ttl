@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix : <http://example.org/rules/> .
@prefix schema: <http://schema.org/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix cve: <http://purl.org/cyber/cve#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix stx: <http://purl.org/cyber/stx#> .
@prefix uco: <http://purl.org/cyber/uco#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix capec: <http://purl.org/cyber/capec#> .
@prefix ucoex: <http://example.com/ucoex#> .
@base <http://purl.org/cyber/uco#> .


# =============================================================================
# CAPEC ENTITY MAP
# Source: cti/capec/2.1/stix-capec.json (STIX 2.1 bundle)
# Iterates over attack-pattern objects which represent CAPEC entries.
# =============================================================================

<#CAPECMap> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "./data/cti/stix-capec.json";
        rml:referenceFormulation ql:JSONPath;
        rml:iterator "$.objects[?(@.type=='attack-pattern')]"
    ];
    rr:subjectMap [
        rr:template "http://example.com/ucoex#{external_references[0].external_id}";
        rr:class <http://purl.org/cyber/ucoAttackPattern>;
        rr:class <http://example.com/ucoexCAPEC>
    ];

    # Label: "CAPEC-1: Name"
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [
            rr:template "{external_references[0].external_id}: {name}" ;
            rr:datatype xsd:string
        ]
    ];

    # CAPEC ID (e.g. "CAPEC-1")
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexCAPEC_id>;
        rr:objectMap [ rml:reference "external_references[0].external_id"; rr:datatype xsd:string ]
    ];

    # Name
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexCAPEC_name>;
        rr:objectMap [ rml:reference "name"; rr:datatype xsd:string ]
    ];

    # Abstraction level (Standard, Detailed, Meta)
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexAbstraction>;
        rr:objectMap [ rml:reference "x_capec_abstraction"; rr:datatype xsd:string ]
    ];

    # Likelihood of attack
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexLikelihood>;
        rr:objectMap [ rml:reference "x_capec_likelihood_of_attack"; rr:datatype xsd:string ]
    ];

    # Typical severity
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexSeverity>;
        rr:objectMap [ rml:reference "x_capec_typical_severity"; rr:datatype xsd:string ]
    ];

    # Description
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexDescription>;
        rr:objectMap [ rml:reference "description"; rr:datatype xsd:string ]
    ];

    # Execution flow (HTML from STIX)
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexExecutionFlowTechnique>;
        rr:objectMap [ rml:reference "x_capec_execution_flow"; rr:datatype xsd:string ]
    ];

    # Prerequisites (array)
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexPrerequisites>;
        rr:objectMap [ rml:reference "x_capec_prerequisites[*]"; rr:datatype xsd:string ]
    ];

    # Resources required (array)
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexResources_Required>;
        rr:objectMap [ rml:reference "x_capec_resources_required[*]"; rr:datatype xsd:string ]
    ];

    # Example instances (array)
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexExample>;
        rr:objectMap [ rml:reference "x_capec_example_instances[*]"; rr:datatype xsd:string ]
    ];

    # Status
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexStatus>;
        rr:objectMap [ rml:reference "x_capec_status"; rr:datatype xsd:string ]
    ];

    # STIX ID (for reference)
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexSTIX_ID>;
        rr:objectMap [ rml:reference "id"; rr:datatype xsd:string ]
    ];

    # Created / Modified timestamps
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexCREATED>;
        rr:objectMap [ rml:reference "created"; rr:datatype xsd:string ]
    ];
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexMODIFIED>;
        rr:objectMap [ rml:reference "modified"; rr:datatype xsd:string ]
    ];

    # --- Cross-references extracted from external_references ---

    # Related Weaknesses (CWE links)
    # external_references where source_name=="cwe" → external_id gives "CWE-276" etc.
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexRelatedWeaknesses>;
        rr:objectMap [
            rml:reference "external_references[?(@.source_name=='cwe')].external_id";
            rr:datatype xsd:string
        ]
    ];

    # Relationship link: CAPEC → CWE node
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoex#hasRelatedWeakness>;
        rr:objectMap [
            rr:template "http://purl.org/cyber/uco#{external_references[?(@.source_name=='cwe')].external_id}";
            rr:class <http://purl.org/cyber/ucoCWE>
        ]
    ];

    # Taxonomy Mappings to ATT&CK (MITRE IDs like "T1574.010")
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoexTaxonomyMappingATTACK>;
        rr:objectMap [
            rml:reference "external_references[?(@.source_name=='ATTACK')].external_id";
            rr:datatype xsd:string
        ]
    ];

    # Relationship link: CAPEC → ATT&CK technique node
    rr:predicateObjectMap [
        rr:predicate <http://example.com/ucoex#hasTaxonomyMapping>;
        rr:objectMap [
            rr:template "http://example.com/ucoex#{external_references[?(@.source_name=='ATTACK')].external_id}";
            rr:class <http://example.com/ucoexTechnique>
        ]
    ].


# =============================================================================
# ATT&CK stub map — ensures ATT&CK nodes referenced by CAPEC exist
# Creates minimal ATT&CK nodes from CAPEC's external_references
# =============================================================================

<#ATTACKMap> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "./data/cti/stix-capec.json";
        rml:referenceFormulation ql:JSONPath;
        rml:iterator "$.objects[?(@.type=='attack-pattern')]"
    ];
    rr:subjectMap [
        rr:template "http://example.com/ucoex#{external_references[?(@.source_name=='ATTACK')].external_id}";
        rr:class <http://purl.org/cyber/ucoAttackPattern>;
        rr:class <http://example.com/ucoexTechnique>
    ].


# =============================================================================
# CWE stub map — ensures CWE nodes referenced by CAPEC exist
# =============================================================================

<#CWEMap> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "./data/cti/stix-capec.json";
        rml:referenceFormulation ql:JSONPath;
        rml:iterator "$.objects[?(@.type=='attack-pattern')]"
    ];
    rr:subjectMap [
        rr:template "http://purl.org/cyber/uco#{external_references[?(@.source_name=='cwe')].external_id}";
        rr:class <http://purl.org/cyber/ucoCWE>
    ].
