  "Relationship Traversal Queries": [
    {
      "category": "Relationship Traversal Queries",
      "nl": "List campaigns that use 'powershell'.",
      "cypher": "MATCH (c:UcoexCAMPAIGNS)-[:UCOEXCAMPAIGNUSESSOFTWARE]->(s:UcoexSOFTWARE {ucoexNAME: 'powershell'}) RETURN c.ucoexNAME",
      "hops": 1,
      "expected_labels": [
        "UcoexCAMPAIGNS",
        "UcoexSOFTWARE"
      ],
      "expected_relationships": [
        "UCOEXCAMPAIGNUSESSOFTWARE"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    },
    {
      "category": "Relationship Traversal Queries",
      "nl": "Find software that uses MITRE ATT&CK techniques mapped from 'CAPEC-100: SQL Injection'.",
      "cypher": "MATCH (s:UcoexSOFTWARE)-[:UCOEXSOFTWAREUSESTECHNIQUE]->(a:UcoexMITREATTACK)<-[:UCOEXHASTAXONOMYMAPPING]-(c:UcoexCAPEC {ucoexCAPEC_name: 'CAPEC-100: SQL Injection'}) RETURN DISTINCT s.ucoexDESCRIPTION, a.ucoexDESCRIPTION",
      "hops": 2,
      "expected_labels": [
        "UcoexCAPEC",
        "UcoexMITREATTACK",
        "UcoexSOFTWARE"
      ],
      "expected_relationships": [
        "UCOEXHASTAXONOMYMAPPING",
        "UCOEXSOFTWAREUSESTECHNIQUE"
      ],
      "expected_properties": [
        "ucoexCAPEC_name",
        "ucoexDESCRIPTION"
      ]
    },
    {
      "category": "Relationship Traversal Queries",
      "nl": "Show me CAPECs and Software that relate to the same MITRE ATT&CK technique.",
      "cypher": "MATCH (c:UcoexCAPEC)-[:UCOEXHASTAXONOMYMAPPING]->(a:UcoexMITREATTACK)<-[:UCOEXSOFTWAREUSESTECHNIQUE]-(s:UcoexSOFTWARE) RETURN c.ucoexCAPEC_name AS capec, a.ucoexDESCRIPTION AS technique, s.ucoexDESCRIPTION AS software",
      "hops": 2,
      "expected_labels": [
        "UcoexCAPEC",
        "UcoexMITREATTACK",
        "UcoexSOFTWARE"
      ],
      "expected_relationships": [
        "UCOEXHASTAXONOMYMAPPING",
        "UCOEXSOFTWAREUSESTECHNIQUE"
      ],
      "expected_properties": [
        "ucoexCAPEC_name",
        "ucoexDESCRIPTION"
      ]
    },
    {
      "category": "Relationship Traversal Queries",
      "nl": "Show me campaigns linked to the Lazarus Group.",
      "cypher": "MATCH (g:UcoexGROUPS {ucoexNAME: 'Lazarus Group'})<-[:UCOEXATTRIBUTEDTO]-(c:UcoexCAMPAIGNS) RETURN c.ucoexNAME",
      "hops": 1,
      "expected_labels": [
        "UcoexCAMPAIGNS",
        "UcoexGROUPS"
      ],
      "expected_relationships": [
        "UCOEXATTRIBUTEDTO"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    },
    {
      "category": "Relationship Traversal Queries",
      "nl": "Find groups that use 'netcat'.",
      "cypher": "MATCH (g:UcoexGROUPS)-[:UCOEXGROUPUSESSOFTWARE]->(s:UcoexSOFTWARE {ucoexNAME: 'netcat'}) RETURN g.ucoexNAME",
      "hops": 1,
      "expected_labels": [
        "UcoexGROUPS",
        "UcoexSOFTWARE"
      ],
      "expected_relationships": [
        "UCOEXGROUPUSESSOFTWARE"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    }
  ],
  "Multi-hop Queries": [
    {
      "category": "Multi-hop Queries",
      "nl": "What CPEs (products) are affected by 'CVE-2017-0199'?",
      "cypher": "MATCH (c:UcoCVE {label: 'CVE-2017-0199'})-[:UCOEXHASCPE]->(cpe:UcoexCPE) RETURN cpe.uri",
      "hops": 1,
      "expected_labels": [
        "UcoCVE",
        "UcoexCPE"
      ],
      "expected_relationships": [
        "UCOEXHASCPE"
      ],
      "expected_properties": [
        "label",
        "uri"
      ]
    },
    {
      "category": "Multi-hop Queries",
      "nl": "What techniques are used in campaigns attributed to 'APT29'?",
      "cypher": "MATCH (g:UcoexGROUPS {ucoexNAME: 'APT29'})<-[:UCOEXATTRIBUTEDTO]-(c:UcoexCAMPAIGNS)-[:UCOEXCAMPAIGNUSESTECHNIQUE]->(t:UcoexMITREATTACK) RETURN c.ucoexNAME, t.ucoexNAME",
      "hops": 2,
      "expected_labels": [
        "UcoexCAMPAIGNS",
        "UcoexGROUPS",
        "UcoexMITREATTACK"
      ],
      "expected_relationships": [
        "UCOEXATTRIBUTEDTO",
        "UCOEXCAMPAIGNUSESTECHNIQUE"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    },
    {
      "category": "Multi-hop Queries",
      "nl": "What mitigations exist for the TTPs associated with FIN7's known toolset?",
      "cypher": "MATCH (:UcoexGROUPS {ucoexNAME: 'FIN7'})-[:UCOEXGROUPUSESSOFTWARE]->(:UcoexSOFTWARE)-[:UCOEXSOFTWAREUSESTECHNIQUE]->(t:UcoexMITREATTACK)<-[:UCOEXMITIGATES]-(m:UcoexMITIGATIONS) RETURN m.ucoexNAME",
      "hops": 3,
      "expected_labels": [
        "UcoexGROUPS",
        "UcoexMITIGATIONS",
        "UcoexMITREATTACK",
        "UcoexSOFTWARE"
      ],
      "expected_relationships": [
        "UCOEXGROUPUSESSOFTWARE",
        "UCOEXMITIGATES",
        "UCOEXSOFTWAREUSESTECHNIQUE"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    },
    {
      "category": "Multi-hop Queries",
      "nl": "Find vulnerabilities that share the same weakness type (CWE) as CVE-2017-0144, based on observed incidents.",
      "cypher": "MATCH (:UcoCVE {label: 'CVE-2017-0144'})<-[:UCOEXEXAMPLEOBSERVEDIN]-(:UcoexObservedExample)<-[:UCOHASOBSERVEDEXAMPLE]-(w:UcoCWE)<-[:UCOHASWEAKNESS]-(:UcoExploitTarget)-[:UCOHASVULNERABILITY]->(v:UcoVulnerability) RETURN v.ucosummary",
      "hops": 4,
      "expected_labels": [
        "UcoCVE",
        "UcoCWE",
        "UcoExploitTarget",
        "UcoVulnerability",
        "UcoexObservedExample"
      ],
      "expected_relationships": [
        "UCOEXEXAMPLEOBSERVEDIN",
        "UCOHASOBSERVEDEXAMPLE",
        "UCOHASVULNERABILITY",
        "UCOHASWEAKNESS"
      ],
      "expected_properties": [
        "label",
        "ucosummary"
      ]
    },
    {
      "category": "Multi-hop Queries",
      "nl": "Which CVEs were exploited during the WannaCry campaign?",
      "cypher": "MATCH (:UcoexCAMPAIGNS {ucoexNAME: 'WannaCry Ransomware Attack'})-[:UCOEXCAMPAIGNUSESTECHNIQUE]->(t:UcoexMITREATTACK)<-[:UCOEXHASTAXONOMYMAPPING]-(:UcoexCAPEC)-[:UCOEXHASRELATEDWEAKNESS]->(:UcoCWE)<-[:UCOHASWEAKNESS]-(et:UcoExploitTarget)-[:UCOHASVULNERABILITY]->(v:UcoVulnerability)-[:UCOHASCVE_ID]->(cve:UcoCVE) RETURN cve.label",
      "hops": 6,
      "expected_labels": [
        "UcoCVE",
        "UcoCWE",
        "UcoExploitTarget",
        "UcoVulnerability",
        "UcoexCAMPAIGNS",
        "UcoexCAPEC",
        "UcoexMITREATTACK"
      ],
      "expected_relationships": [
        "UCOEXCAMPAIGNUSESTECHNIQUE",
        "UCOEXHASRELATEDWEAKNESS",
        "UCOEXHASTAXONOMYMAPPING",
        "UCOHASCVE_ID",
        "UCOHASVULNERABILITY",
        "UCOHASWEAKNESS"
      ],
      "expected_properties": [
        "label",
        "ucoexNAME"
      ]
    }
  ],
  "Aggregation and Counting": [
    {
