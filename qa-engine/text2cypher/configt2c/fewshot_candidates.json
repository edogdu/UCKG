{
  "Node Lookup Queries": [
    {
      "category": "Node Lookup Queries",
      "nl": "Get the name and description for CWE-89.",
      "cypher": "MATCH (c:UcoCWE {ucocweID: 'CWE-89'}) RETURN c.ucocweName, c.ucodescription",
      "hops": 0,
      "expected_labels": [
        "UcoCWE"
      ],
      "expected_relationships": [],
      "expected_properties": [
        "ucocweID",
        "ucocweName",
        "ucodescription"
      ]
    },
    {
      "category": "Node Lookup Queries",
      "nl": "What campaigns are attributed to the threat actor FIN7?",
      "cypher": "MATCH (g:UcoexGROUPS {ucoexNAME: 'FIN7'})<-[:UCOEXATTRIBUTEDTO]-(c:UcoexCAMPAIGNS) RETURN c.ucoexNAME",
      "hops": 1,
      "expected_labels": [
        "UcoexCAMPAIGNS",
        "UcoexGROUPS"
      ],
      "expected_relationships": [
        "UCOEXATTRIBUTEDTO"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    },
    {
      "category": "Node Lookup Queries",
      "nl": "Pull the record for CVE-2021-44228.",
      "cypher": "MATCH (c:UcoCVE {label: 'CVE-2021-44228'}) RETURN c",
      "hops": 0,
      "expected_labels": [
        "UcoCVE"
      ],
      "expected_relationships": [],
      "expected_properties": [
        "label"
      ]
    },
    {
      "category": "Node Lookup Queries",
