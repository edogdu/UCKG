      "expected_labels": [
        "UcoCWE",
        "UcoexMITRED3FEND"
      ],
      "expected_relationships": [],
      "expected_properties": [
        "ucocweName",
        "ucoexMITRED3FEND_DEFINITION"
      ]
    },
    {
