    {
      "category": "Aggregation and Counting",
      "nl": "How many threat groups have at least one campaign attributed to them?",
      "cypher": "MATCH (g:UcoexGROUPS)<-[:UCOEXATTRIBUTEDTO]-(:UcoexCAMPAIGNS) RETURN count(DISTINCT g) AS groupsWithCampaigns",
      "hops": 1,
      "expected_labels": [
        "UcoexCAMPAIGNS",
        "UcoexGROUPS"
      ],
      "expected_relationships": [
        "UCOEXATTRIBUTEDTO"
      ],
      "expected_properties": []
    }
