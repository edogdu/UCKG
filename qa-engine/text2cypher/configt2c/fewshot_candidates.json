      ]
    },
    {
      "category": "Aggregation and Counting",
      "nl": "Count the number of distinct TTPs linked to APT28.",
      "cypher": "MATCH (g:UcoexGROUPS {ucoexNAME: 'APT28'})-[:UCOEXGROUPUSESTECHNIQUE]->(t:UcoexMITREATTACK) RETURN count(t)",
      "hops": 1,
      "expected_labels": [
        "UcoexGROUPS",
        "UcoexMITREATTACK"
      ],
      "expected_relationships": [
        "UCOEXGROUPUSESTECHNIQUE"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    },
    {
      "category": "Aggregation and Counting",
      "nl": "How many related weaknesses (CWEs) does each 'High' severity CAPEC pattern have?",
      "cypher": "MATCH (ca:UcoexCAPEC {ucoexSeverity: 'High'})-[:UCOEXHASRELATEDWEAKNESS]->(w:UcoCWE) RETURN ca.ucoexCAPEC_name, count(w) AS weaknessCount",
      "hops": 1,
      "expected_labels": [
        "UcoCWE",
        "UcoexCAPEC"
