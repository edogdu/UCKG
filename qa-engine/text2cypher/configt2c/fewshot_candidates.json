  "Conditional and Boolean Queries": [
    {
      "category": "Conditional and Boolean Queries",
      "nl": "Show me high-impact (score > 5) CVEs that require no user interaction to exploit.",
      "cypher": "MATCH (c:UcoCVE) WHERE toInteger(c.ucoimpactScore) > 5 AND c.ucouserInteractionRequired = 'false' RETURN c.label, c.ucoimpactScore",
      "hops": 0,
      "expected_labels": [
        "UcoCVE"
      ],
      "expected_relationships": [],
      "expected_properties": [
        "label",
        "ucoimpactScore",
        "ucouserInteractionRequired"
      ]
    },
    {
      "category": "Conditional and Boolean Queries",
      "nl": "What TTPs does Lazarus Group use, excluding 'Phishing'?",
      "cypher": "MATCH (:UcoexGROUPS {ucoexNAME: 'Lazarus Group'})-[:UCOEXGROUPUSESTECHNIQUE]->(t:UcoexMITREATTACK) WHERE t.ucoexNAME <> 'Phishing' RETURN t.ucoexNAME",
      "hops": 1,
      "expected_labels": [
        "UcoexGROUPS",
        "UcoexMITREATTACK"
      ],
      "expected_relationships": [
        "UCOEXGROUPUSESTECHNIQUE"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    },
    {
      "category": "Conditional and Boolean Queries",
      "nl": "What software is used by 'Lazarus Group' AND was also used in the 'WannaCry' campaign?",
      "cypher": "MATCH (g:UcoexGROUPS {ucoexNAME: 'Lazarus Group'})-[:UCOEXGROUPUSESSOFTWARE]->(s:UcoexSOFTWARE)<-[:UCOEXCAMPAIGNUSESSOFTWARE]-(c:UcoexCAMPAIGNS {ucoexNAME: 'WannaCry'}) RETURN s.ucoexNAME",
      "hops": 2,
      "expected_labels": [
        "UcoexCAMPAIGNS",
        "UcoexGROUPS",
        "UcoexSOFTWARE"
      ],
      "expected_relationships": [
        "UCOEXCAMPAIGNUSESSOFTWARE",
        "UCOEXGROUPUSESSOFTWARE"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    },
    {
      "category": "Conditional and Boolean Queries",
      "nl": "Find techniques used by 'Sandworm Team' for which mitigations exist.",
      "cypher": "MATCH (g:UcoexGROUPS {ucoexNAME: 'Sandworm Team'})-[:UCOEXGROUPUSESTECHNIQUE]->(t:UcoexMITREATTACK)<-[:UCOEXMITIGATES]-(m:UcoexMITIGATIONS) RETURN DISTINCT t.ucoexNAME",
      "hops": 2,
      "expected_labels": [
        "UcoexGROUPS",
        "UcoexMITIGATIONS",
        "UcoexMITREATTACK"
      ],
      "expected_relationships": [
        "UCOEXGROUPUSESTECHNIQUE",
        "UCOEXMITIGATES"
      ],
      "expected_properties": [
        "ucoexNAME"
      ]
    },
    {
      "category": "Conditional and Boolean Queries",
      "nl": "Find exploit targets with a known vulnerability BUT no known weakness.",
      "cypher": "MATCH (et:UcoExploitTarget) WHERE (et)-[:UCOHASVULNERABILITY]->(:UcoVulnerability) AND NOT (et)-[:UCOHASWEAKNESS]->(:UcoCWE) RETURN et.uri",
      "hops": 2,
      "expected_labels": [
        "UcoCWE",
        "UcoExploitTarget",
        "UcoVulnerability"
      ],
      "expected_relationships": [
        "UCOHASVULNERABILITY",
        "UCOHASWEAKNESS"
      ],
      "expected_properties": [
        "uri"
      ]
    }
  ],
  "Path Queries (Variable-length)": [
