# Neo4j Database Credentials
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here

# LLM Configuration for SFT Engine (Synthesizer)
SYNTHESIZER_MODEL=gemini-2.0-flash-lite-001
SYNTHESIZER_BACKEND=openai_api
SYNTHESIZER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SYNTHESIZER_API_KEY=your_gemini_api_key_here
